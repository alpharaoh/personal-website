---
import BaseHead from './BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  activeTab?: 'experience' | 'projects' | 'writings' | 'links';
}

const { activeTab } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <div class="container">
        <pre>{`
+------------------------------------------------------------------------------+
|                                                                              |`}</pre>
        <h1><a href="mailto:akaam@shamerany.com">Akaam<span class="email-hint">@</span>Shamerany<span class="email-hint">.com</span></a></h1>
        <p>Fullstack engineer -- I work on product and build on the cutting edge.</p>
        <pre>{`|                                                                              |
+------------------------------------------------------------------------------+`}</pre>
        <div class="tabs">
          <a href="/" class={activeTab === 'experience' ? 'active' : ''}>Experience</a>
          <a href="/projects" class={activeTab === 'projects' ? 'active' : ''}>Projects</a>
          <a href="/writings" class={activeTab === 'writings' ? 'active' : ''}>Writings</a>
          <a href="/links" class={activeTab === 'links' ? 'active' : ''}>Links</a>
        </div>
        <slot />
      </div>
    </main>
  </body>
</html>
