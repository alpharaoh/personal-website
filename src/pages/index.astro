---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const writings = (await getCollection('writings')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 5);
---

<Layout activeTab="experience">
        <pre>{`+------------------------------------------------------------------------------+
|  WORK (highlights)                                       `}[<a href="/cv.pdf" download>download full CV</a>]{`  |
+------------------------------------------------------------------------------+
`}</pre>
  <div>
    <h3><a href="https://bland.ai" target="_blank">Bland.ai</a>  <span>-- AI phone agents</span></h3>
    <ul>
      <li>
        Engineered live translation over telephony (industry first)
      </li>
      <li>
        Developed SSR web chat widget (voice + chat)
      </li>
      <li>
        Built deterministic agent testing framework for users
      </li>
      <li>
        Architected compliance and legal guard rails that can be customized for any AI agent
      </li>
    </ul>
  </div>
  <div>
    <h3><a href="https://11x.ai" target="_blank">11x.ai</a>  <span>-- Sales AI agent</span></h3>
    <ul>
      <li>
        Head of engineering
      </li>
      <li>
        Implemented the entire LinkedIn automation systems
      </li>
      <li>
        Built website tracking lead generation systems
      </li>
      <li>
        Rebuilt the entire frontend platform, backend systems and AI agents
      </li>
    </ul>
  </div>
  <div>
    <h3><a href="https://quantumboost.com" target="_blank">Quantum boost</a>  <span>-- Accelerating material science using ML/AI</span></h3>
    <ul>
      <li>
        Founding engineer
      </li>
      <li>
        Developed custom Bayesian Optimisation with Gaussian Process algorithm for chemical formulation
      </li>
      <li>
        Built probability visualization systems to enable understanding underlying models
      </li>
      <li>
        Engineered chemical formulation constraints and XOR material exclusion logic
      </li>
    </ul>
  </div>
  <br/>
  <pre>{`
+------------------------------------------------------------------------------+
|  EDUCATION                                                                   |
+------------------------------------------------------------------------------+
`}</pre>
  <div>
    <h3>University of Birmingham</h3>
    <ul>
      <li>
        Masters of Computer Science -- final year drop out
      </li>
    </ul>
  </div>
  <div>
    <h3>Highfield School</h3>
    <ul>
      <li>
        A levels: A* (Physics), A* (Mathematics), A (Computer Science)
      </li>
      <li>
        GCSE: <span title="Chemistry">A**</span>, <span title="Physics">A*</span>, <span title="Mathematics">A*</span>, <span title="Computer Science">A*</span>, <span title="English Literature">A*</span>, <span title="English Language">A*</span>, <span title="History">A</span>, <span title="Geography">A</span>, <span title="French">A</span>, <span title="Religious Studies">A</span>, <span title="Art">A</span>
      </li>
      <li>
        Awarded best Maths and Science student
      </li>
    </ul>
  </div>
  <br/>
  <pre>{`
+------------------------------------------------------------------------------+
|  RECENT WRITINGS                                              `}[<a href="/writings">see all --&gt;</a>]{`  |
+------------------------------------------------------------------------------+
`}</pre>
  <div class="writings-list">
    {
      writings.length === 0 ? (
        <p>No writings yet...</p>
      ) : (
        writings.map((writing) => (
          <div class="writing-item">
            <span class="writing-arrow">&gt;</span>
            <a href={`/writings/${writing.id}/`}>
              <span class="writing-title">{writing.data.title}</span>
            </a>
            <span class="writing-date">(<FormattedDate date={writing.data.pubDate} />)</span>
          </div>
        ))
      )
    }
  </div>
</Layout>

<style>
  .writings-list {
    margin-top: 0.5rem;
  }

  .writing-item {
    margin-bottom: 0.5rem;
  }

  .writing-arrow {
    color: #666;
    margin-right: 0.5rem;
  }

  .writing-item a {
    color: blue;
  }

  .writing-date {
    color: #666;
    margin-left: 0.5rem;
    font-size: 0.85rem;
  }
</style>
